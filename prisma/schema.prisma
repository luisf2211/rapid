  status           String        @default("N'PENDING'", map: "DF_Invoice_Status") @map("Status") @db.NVarChar(30)
  laborSubtotal    Decimal       @default(0, map: "DF_Invoice_Labor") @map("LaborSubtotal") @db.Decimal(18, 2)
  materialSubtotal Decimal       @default(0, map: "DF_Invoice_Material") @map("MaterialSubtotal") @db.Decimal(18, 2)
  partsSubtotal    Decimal       @default(0, map: "DF_Invoice_Parts") @map("PartsSubtotal") @db.Decimal(18, 2)
  subtotal         Decimal       @default(0, map: "DF_Invoice_Subtotal") @map("Subtotal") @db.Decimal(18, 2)
  discountAmount   Decimal       @default(0, map: "DF_Invoice_Discount") @map("DiscountAmount") @db.Decimal(18, 2)
  taxRate          Decimal       @default(0.18, map: "DF_Invoice_TaxRate") @map("TaxRate") @db.Decimal(5, 4)
  taxAmount        Decimal       @default(0, map: "DF_Invoice_Tax") @map("TaxAmount") @db.Decimal(18, 2)
  grandTotal       Decimal       @default(0, map: "DF_Invoice_Total") @map("GrandTotal") @db.Decimal(18, 2)
  paidAt           DateTime?     @map("PaidAt")
  paidBy           String?       @map("PaidBy") @db.NVarChar(150)
  paymentReference String?       @map("PaymentReference") @db.NVarChar(100)
  voidedAt         DateTime?     @map("VoidedAt")
  voidedBy         String?       @map("VoidedBy") @db.NVarChar(150)
  voidReason       String?       @map("VoidReason") @db.NVarChar(500)
  notes            String?       @map("Notes") @db.NVarChar(Max)
  createdAt        DateTime      @default(dbgenerated("sysdatetime()"), map: "DF_Invoice_CreatedAt") @map("CreatedAt")
  createdBy        String?       @map("CreatedBy") @db.NVarChar(150)
  updatedAt        DateTime?     @map("UpdatedAt")
  updatedBy        String?       @map("UpdatedBy") @db.NVarChar(150)
  quotation        Quotation?    @relation(fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Invoice_Quotation")
  workOrder        WorkOrder     @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_Invoice_WorkOrder")
  company          Company       @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_Invoice_Company")
