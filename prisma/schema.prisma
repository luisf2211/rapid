  AdvancesAmount                                                            Decimal           @default(0, map: "DF_PayrollSettlement_Advances") @db.Decimal(18, 2)
  AdjustmentsAmount                                                         Decimal           @default(0, map: "DF_PayrollSettlement_Adj") @db.Decimal(18, 2)
  NetAmount                                                                 Decimal           @default(0, map: "DF_PayrollSettlement_Net") @db.Decimal(18, 2)
