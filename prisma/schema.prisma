// Rapid - SaaS para talleres de pintura automotriz
// Prisma schema mapeado contra el SQL Server existente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model WorkOrder {
  id            Int       @id(map: "PK__WorkOrde__3214EC07B767C033") @default(autoincrement()) @map("Id")
  orderNumber   Int       @unique(map: "UQ__WorkOrde__CAC5E7431FE44356") @map("OrderNumber")
  customerName  String?   @map("CustomerName") @db.NVarChar(150)
  phone         String?   @map("Phone") @db.NVarChar(50)
  email         String?   @map("Email") @db.NVarChar(150)
  address       String?   @map("Address") @db.NVarChar(250)
  brand         String?   @map("Brand") @db.NVarChar(80)
  model         String?   @map("Model") @db.NVarChar(80)
  vehicleYear   Int?      @map("VehicleYear")
  color         String?   @map("Color") @db.NVarChar(50)
  plate         String?   @map("Plate") @db.NVarChar(30)
  mileage       String?   @map("Mileage") @db.NVarChar(50)
  engine        String?   @map("Engine") @db.NVarChar(50)
  status        String    @default("RECEIVED", map: "DF__WorkOrder__Statu__38996AB5") @map("Status") @db.NVarChar(50)
  notes         String?   @map("Notes") @db.NVarChar(Max)
  createdAt     DateTime? @default(dbgenerated("sysdatetime()"), map: "DF__WorkOrder__Creat__398D8EEE") @map("CreatedAt")
  updatedAt     DateTime? @map("UpdatedAt")

  receptions           WorkOrderReception[]
  photos               WorkOrderPhoto[]
  damages              WorkOrderDamage[]
  quotationId          Int?                  @map("QuotationId")
  materialRequisitions MaterialRequisition[]
  laborOrders          LaborOrder[]
  inventoryMovements   InventoryMovement[]
  quotation            Quotation?            @relation("WorkOrderFromQuotation", fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  convertedFrom        Quotation?            @relation("QuotationConvertedWorkOrder")

  @@map("WorkOrder")
}

model InventoryPart {
  id               Int       @id(map: "PK_InventoryPart") @default(autoincrement()) @map("Id")
  sku              String    @map("Sku") @db.NVarChar(50)
  name             String    @map("Name") @db.NVarChar(150)
  description      String?   @map("Description") @db.NVarChar(250)
  category         String?   @map("Category") @db.NVarChar(80)
  unit             String    @default("PZ", map: "DF_InventoryPart_Unit") @map("Unit") @db.NVarChar(20)
  quantityOnHand   Decimal   @default(0, map: "DF_InventoryPart_Qty") @map("QuantityOnHand") @db.Decimal(18, 2)
  reservedQuantity Decimal   @default(0, map: "DF_InventoryPart_ReservedQty") @map("ReservedQuantity") @db.Decimal(18, 2)
  minQuantity      Decimal?  @map("MinQuantity") @db.Decimal(18, 2)
  unitCost         Decimal?  @map("UnitCost") @db.Decimal(18, 2)
  location         String?   @map("Location") @db.NVarChar(80)
  isActive         Boolean   @default(true, map: "DF_InventoryPart_IsActive") @map("IsActive")
  createdAt        DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_InventoryPart_CreatedAt") @map("CreatedAt")
  createdBy        String?   @map("CreatedBy") @db.NVarChar(150)
  updatedAt        DateTime? @map("UpdatedAt")
  updatedBy        String?   @map("UpdatedBy") @db.NVarChar(150)

  movements              InventoryMovement[]
  quotationMaterialLines QuotationMaterialLine[]

  @@map("InventoryPart")
}

model InventoryMovement {
  id                 Int       @id(map: "PK_InventoryMovement") @default(autoincrement()) @map("Id")
  inventoryPartId    Int       @map("InventoryPartId")
  movementType       String    @map("MovementType") @db.NVarChar(20)
  quantity           Decimal   @map("Quantity") @db.Decimal(18, 2)
  quantityBefore     Decimal?  @map("QuantityBefore") @db.Decimal(18, 2)
  quantityAfter      Decimal?  @map("QuantityAfter") @db.Decimal(18, 2)
  unitCostAtMovement Decimal?  @map("UnitCostAtMovement") @db.Decimal(18, 2)
  reason             String?   @map("Reason") @db.NVarChar(50)
  workOrderId        Int?      @map("WorkOrderId")
  notes              String?   @map("Notes") @db.NVarChar(250)
  createdBy          String?   @map("CreatedBy") @db.NVarChar(150)
  createdAt          DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_InventoryMovement_CreatedAt") @map("CreatedAt")

  part      InventoryPart @relation(fields: [inventoryPartId], references: [id], onUpdate: NoAction, map: "FK_InventoryMovement_Part")
  workOrder WorkOrder?    @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_InventoryMovement_WorkOrder")

  @@map("InventoryMovement")
}

model WorkOrderReception {
  id                        Int       @id(map: "PK__WorkOrde__3214EC0705CE3673") @default(autoincrement()) @map("Id")
  workOrderId               Int       @map("WorkOrderId")
  deliveryDate              DateTime? @map("DeliveryDate") @db.Date
  deliveryTime              DateTime? @map("DeliveryTime") @db.Time
  exitDate                  DateTime? @map("ExitDate") @db.Date
  exitTime                  DateTime? @map("ExitTime") @db.Time
  fuelLevel                 String?   @map("FuelLevel") @db.NVarChar(20)
  observations              String?   @map("Observations") @db.NVarChar(Max)
  requestedDamages          String?   @map("RequestedDamages") @db.NVarChar(Max)
  customerDeliverySignature String?   @map("CustomerDeliverySignature") @db.NVarChar(500)
  customerReceivedSignature String?   @map("CustomerReceivedSignature") @db.NVarChar(500)
  receivedBy                String?   @map("ReceivedBy") @db.NVarChar(150)
  deliveredBy               String?   @map("DeliveredBy") @db.NVarChar(150)
  createdAt                 DateTime? @default(dbgenerated("sysdatetime()"), map: "DF__WorkOrder__Creat__3C69FB99") @map("CreatedAt")

  workOrder WorkOrder                     @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_WorkOrderReception_WorkOrder")
  checklist WorkOrderReceptionChecklist[]

  @@map("WorkOrderReception")
}

model WorkOrderReceptionChecklist {
  id                   Int      @id(map: "PK__WorkOrde__3214EC07A4BFEC1A") @default(autoincrement()) @map("Id")
  workOrderReceptionId Int      @map("WorkOrderReceptionId")
  itemName             String   @map("ItemName") @db.NVarChar(100)
  isChecked            Boolean  @default(false, map: "DF__WorkOrder__IsChe__403A8C7D") @map("IsChecked")
  yesValue             Boolean? @map("YesValue")
  noValue              Boolean? @map("NoValue")
  comments             String?  @map("Comments") @db.NVarChar(Max)
  hasComment           Boolean  @default(false, map: "DF_WorkOrderReceptionChecklist_HasComment") @map("HasComment")

  reception WorkOrderReception @relation(fields: [workOrderReceptionId], references: [id], onUpdate: NoAction, map: "FK_Checklist_Reception")

  @@map("WorkOrderReceptionChecklist")
}

model WorkOrderPhoto {
  id          Int       @id(map: "PK__WorkOrde__3214EC0782CDD5C9") @default(autoincrement()) @map("Id")
  workOrderId Int       @map("WorkOrderId")
  photoUrl    String    @map("PhotoUrl") @db.NVarChar(500)
  photoType   String?   @map("PhotoType") @db.NVarChar(50)
  description String?   @map("Description") @db.NVarChar(250)
  createdAt   DateTime? @default(dbgenerated("sysdatetime()"), map: "DF__WorkOrder__Creat__440B1D61") @map("CreatedAt")

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_WorkOrderPhoto_WorkOrder")

  @@map("WorkOrderPhoto")
}

model WorkOrderDamage {
  id          Int      @id(map: "PK__WorkOrde__3214EC0797756682") @default(autoincrement()) @map("Id")
  workOrderId Int      @map("WorkOrderId")
  vehicleSide String?  @map("VehicleSide") @db.NVarChar(30)
  damageType  String?  @map("DamageType") @db.NVarChar(50)
  positionX   Decimal? @map("PositionX") @db.Decimal(10, 4)
  positionY   Decimal? @map("PositionY") @db.Decimal(10, 4)
  description String?  @map("Description") @db.NVarChar(250)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_WorkOrderDamage_WorkOrder")

  @@map("WorkOrderDamage")
}

model MaterialRequisition {
  id           Int       @id(map: "PK__Material__3214EC076872FBDF") @default(autoincrement()) @map("Id")
  workOrderId  Int       @map("WorkOrderId")
  disassembler String?   @map("Disassembler") @db.NVarChar(150) // Desarme
  desab        String?   @map("Desab") @db.NVarChar(150)        // Desabollador
  prep         String?   @map("Prep") @db.NVarChar(150)         // Preparador
  painter      String?   @map("Painter") @db.NVarChar(150)      // Pintor
  polisher     String?   @map("Polisher") @db.NVarChar(150)     // Pulidor
  total        Decimal?  @map("Total") @db.Decimal(18, 2)
  createdAt    DateTime? @default(dbgenerated("sysdatetime()"), map: "DF__MaterialR__Creat__4AB81AF0") @map("CreatedAt")

  workOrder WorkOrder                 @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_MaterialRequisition_WorkOrder")
  items     MaterialRequisitionItem[]

  @@map("MaterialRequisition")
}

model MaterialRequisitionItem {
  id                    Int      @id(map: "PK__Material__3214EC07554D5DF4") @default(autoincrement()) @map("Id")
  materialRequisitionId Int      @map("MaterialRequisitionId")
  productName           String   @map("ProductName") @db.NVarChar(150)
  quantity              Decimal? @map("Quantity") @db.Decimal(18, 2)
  unitPrice             Decimal? @map("UnitPrice") @db.Decimal(18, 2)
  total                 Decimal? @map("Total") @db.Decimal(18, 2)
  assignedEmployee      String?  @map("AssignedEmployee") @db.NVarChar(150)

  requisition MaterialRequisition @relation(fields: [materialRequisitionId], references: [id], onUpdate: NoAction, map: "FK_MaterialItem_Requisition")

  @@map("MaterialRequisitionItem")
}

model LaborOrder {
  id           Int       @id(map: "PK__LaborOrd__3214EC07E1DA3F99") @default(autoincrement()) @map("Id")
  workOrderId  Int       @map("WorkOrderId")
  disassembler String?   @map("Disassembler") @db.NVarChar(150) // Desarme
  desab        String?   @map("Desab") @db.NVarChar(150)        // Desabollador
  prep         String?   @map("Prep") @db.NVarChar(150)         // Preparador
  painter      String?   @map("Painter") @db.NVarChar(150)      // Pintor
  polisher     String?   @map("Polisher") @db.NVarChar(150)     // Pulidor
  total        Decimal?  @map("Total") @db.Decimal(18, 2)
  createdAt    DateTime? @default(dbgenerated("sysdatetime()"), map: "DF__LaborOrde__Creat__5165187F") @map("CreatedAt")

  workOrder WorkOrder        @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_LaborOrder_WorkOrder")
  items     LaborOrderItem[]

  @@map("LaborOrder")
}

model LaborOrderItem {
  id               Int      @id(map: "PK__LaborOrd__3214EC07B9FF4953") @default(autoincrement()) @map("Id")
  laborOrderId     Int      @map("LaborOrderId")
  partName         String   @map("PartName") @db.NVarChar(150)
  disassemblerCost Decimal? @map("DisassemblerCost") @db.Decimal(18, 2)
  desabCost        Decimal? @map("DesabCost") @db.Decimal(18, 2)
  prepCost         Decimal? @map("PrepCost") @db.Decimal(18, 2)
  painterCost      Decimal? @map("PainterCost") @db.Decimal(18, 2)
  polisherCost     Decimal? @map("PolisherCost") @db.Decimal(18, 2)
  total            Decimal? @map("Total") @db.Decimal(18, 2)

  laborOrder LaborOrder @relation(fields: [laborOrderId], references: [id], onUpdate: NoAction, map: "FK_LaborItem_LaborOrder")

  @@map("LaborOrderItem")
}

model Quotation {
  id               Int       @id(map: "PK_Quotation") @default(autoincrement()) @map("Id")
  quotationNumber  Int       @unique(map: "UQ_Quotation_Number") @map("QuotationNumber")
  quotationDate    DateTime  @default(dbgenerated("CAST(SYSDATETIME() AS DATE)"), map: "DF_Quotation_Date") @map("QuotationDate") @db.Date
  validUntil       DateTime? @map("ValidUntil") @db.Date
  quotationType    String    @default("PRIVATE", map: "DF_Quotation_Type") @map("QuotationType") @db.NVarChar(20)
  status           String    @default("DRAFT", map: "DF_Quotation_Status") @map("Status") @db.NVarChar(30)
  customerName     String    @map("CustomerName") @db.NVarChar(150)
  phone            String?   @map("Phone") @db.NVarChar(50)
  email            String?   @map("Email") @db.NVarChar(150)
  nationalId       String?   @map("NationalId") @db.NVarChar(30)
  address          String?   @map("Address") @db.NVarChar(250)
  brand            String?   @map("Brand") @db.NVarChar(80)
  model            String?   @map("Model") @db.NVarChar(80)
  vehicleYear      Int?      @map("VehicleYear")
  color            String?   @map("Color") @db.NVarChar(50)
  plate            String?   @map("Plate") @db.NVarChar(30)
  vin              String?   @map("Vin") @db.NVarChar(30)
  mileage          String?   @map("Mileage") @db.NVarChar(50)
  insuranceCompany String?   @map("InsuranceCompany") @db.NVarChar(150)
  policyNumber     String?   @map("PolicyNumber") @db.NVarChar(80)
  claimNumber      String?   @map("ClaimNumber") @db.NVarChar(80)
  adjusterName     String?   @map("AdjusterName") @db.NVarChar(150)
  adjusterPhone    String?   @map("AdjusterPhone") @db.NVarChar(50)
  deductibleAmount Decimal?  @map("DeductibleAmount") @db.Decimal(18, 2)
  laborSubtotal    Decimal   @default(0, map: "DF_Quotation_Labor") @map("LaborSubtotal") @db.Decimal(18, 2)
  materialSubtotal Decimal   @default(0, map: "DF_Quotation_Material") @map("MaterialSubtotal") @db.Decimal(18, 2)
  partsSubtotal    Decimal   @default(0, map: "DF_Quotation_Parts") @map("PartsSubtotal") @db.Decimal(18, 2)
  taxRate          Decimal   @default(0.18, map: "DF_Quotation_TaxRate") @map("TaxRate") @db.Decimal(5, 4)
  taxAmount        Decimal   @default(0, map: "DF_Quotation_Tax") @map("TaxAmount") @db.Decimal(18, 2)
  discountAmount   Decimal   @default(0, map: "DF_Quotation_Discount") @map("DiscountAmount") @db.Decimal(18, 2)
  grandTotal       Decimal   @default(0, map: "DF_Quotation_Total") @map("GrandTotal") @db.Decimal(18, 2)
  estimatedDays    Int?      @map("EstimatedDays")
  warrantyNotes    String?   @map("WarrantyNotes") @db.NVarChar(500)
  termsNotes       String?   @map("TermsNotes") @db.NVarChar(Max)
  internalNotes    String?   @map("InternalNotes") @db.NVarChar(Max)
  workOrderId      Int?      @unique(map: "UQ_Quotation_WorkOrder") @map("WorkOrderId")
  approvedAt       DateTime? @map("ApprovedAt")
  approvedBy       String?   @map("ApprovedBy") @db.NVarChar(150)
  rejectedAt       DateTime? @map("RejectedAt")
  rejectedBy       String?   @map("RejectedBy") @db.NVarChar(150)
  rejectionReason  String?   @map("RejectionReason") @db.NVarChar(500)
  convertedAt      DateTime? @map("ConvertedAt")
  convertedBy      String?   @map("ConvertedBy") @db.NVarChar(150)
  createdAt        DateTime  @default(dbgenerated("sysdatetime()"), map: "DF_Quotation_CreatedAt") @map("CreatedAt")
  createdBy        String?   @map("CreatedBy") @db.NVarChar(150)
  updatedAt        DateTime? @map("UpdatedAt")
  updatedBy        String?   @map("UpdatedBy") @db.NVarChar(150)

  workOrder     WorkOrder?              @relation("QuotationConvertedWorkOrder", fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceOrders  WorkOrder[]             @relation("WorkOrderFromQuotation")
  laborLines    QuotationLaborLine[]
  materialLines QuotationMaterialLine[]
  partLines     QuotationPartLine[]
  damages       QuotationDamage[]
  photos        QuotationPhoto[]

  @@map("Quotation")
}

model QuotationLaborLine {
  id              Int      @id(map: "PK_QuotationLaborLine") @default(autoincrement()) @map("Id")
  quotationId     Int      @map("QuotationId")
  area            String   @map("Area") @db.NVarChar(50)
  description     String?  @map("Description") @db.NVarChar(250)
  estimatedHours  Decimal? @map("EstimatedHours") @db.Decimal(8, 2)
  hourlyRate      Decimal? @map("HourlyRate") @db.Decimal(18, 2)
  lineTotal       Decimal  @default(0, map: "DF_QuotationLabor_Total") @map("LineTotal") @db.Decimal(18, 2)
  sortOrder       Int      @default(0, map: "DF_QuotationLabor_Sort") @map("SortOrder")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("QuotationLaborLine")
}

model QuotationMaterialLine {
  id              Int      @id(map: "PK_QuotationMaterialLine") @default(autoincrement()) @map("Id")
  quotationId     Int      @map("QuotationId")
  inventoryPartId Int?     @map("InventoryPartId")
  productName     String   @map("ProductName") @db.NVarChar(150)
  quantity        Decimal  @default(1, map: "DF_QuotationMaterial_Qty") @map("Quantity") @db.Decimal(18, 2)
  unit            String?  @map("Unit") @db.NVarChar(20)
  unitPrice       Decimal  @default(0, map: "DF_QuotationMaterial_Price") @map("UnitPrice") @db.Decimal(18, 2)
  lineTotal       Decimal  @default(0, map: "DF_QuotationMaterial_Total") @map("LineTotal") @db.Decimal(18, 2)
  sortOrder       Int      @default(0, map: "DF_QuotationMaterial_Sort") @map("SortOrder")

  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inventoryPart InventoryPart? @relation(fields: [inventoryPartId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("QuotationMaterialLine")
}

model QuotationPartLine {
  id          Int      @id(map: "PK_QuotationPartLine") @default(autoincrement()) @map("Id")
  quotationId Int      @map("QuotationId")
  partName    String   @map("PartName") @db.NVarChar(150)
  description String?  @map("Description") @db.NVarChar(250)
  quantity    Decimal  @default(1, map: "DF_QuotationPart_Qty") @map("Quantity") @db.Decimal(18, 2)
  unitPrice   Decimal  @default(0, map: "DF_QuotationPart_Price") @map("UnitPrice") @db.Decimal(18, 2)
  lineTotal   Decimal  @default(0, map: "DF_QuotationPart_Total") @map("LineTotal") @db.Decimal(18, 2)
  sortOrder   Int      @default(0, map: "DF_QuotationPart_Sort") @map("SortOrder")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("QuotationPartLine")
}

model QuotationDamage {
  id          Int      @id(map: "PK_QuotationDamage") @default(autoincrement()) @map("Id")
  quotationId Int      @map("QuotationId")
  partName    String?  @map("PartName") @db.NVarChar(150)
  vehicleSide String?  @map("VehicleSide") @db.NVarChar(30)
  damageType  String?  @map("DamageType") @db.NVarChar(50)
  description String?  @map("Description") @db.NVarChar(500)
  positionX   Decimal? @map("PositionX") @db.Decimal(10, 4)
  positionY   Decimal? @map("PositionY") @db.Decimal(10, 4)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("QuotationDamage")
}

model QuotationPhoto {
  id          Int      @id(map: "PK_QuotationPhoto") @default(autoincrement()) @map("Id")
  quotationId Int      @map("QuotationId")
  photoUrl    String   @map("PhotoUrl") @db.NVarChar(500)
  category    String?  @map("Category") @db.NVarChar(50)
  description String?  @map("Description") @db.NVarChar(250)
  createdAt   DateTime @default(dbgenerated("sysdatetime()"), map: "DF_QuotationPhoto_Created") @map("CreatedAt")
  createdBy   String?  @map("CreatedBy") @db.NVarChar(150)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("QuotationPhoto")
}
