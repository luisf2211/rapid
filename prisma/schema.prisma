generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               Int                @id(map: "PK_Company") @default(autoincrement()) @map("Id")
  name             String             @map("Name") @db.VarChar(150)
  slug             String             @unique(map: "UQ_Company_Slug") @map("Slug") @db.VarChar(80)
  isActive         Boolean            @default(true) @map("IsActive")
  createdAt        DateTime           @default(now()) @map("CreatedAt")
  users              User[]
  workOrders         WorkOrder[]
  inventoryParts     InventoryPart[]
  quotations         Quotation[]
  invoices           Invoice[]
  employees          Employee[]
  payrollPeriods     PayrollPeriod[]
  workshopSettings   WorkshopSettings[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  bankAccounts       BankAccount[]
  pettyCashFunds     PettyCashFund[]

  @@map("Company")
}

model User {
  id           Int       @id(map: "PK_User") @default(autoincrement()) @map("Id")
  email        String    @unique(map: "UQ_User_Email") @map("Email") @db.VarChar(150)
  passwordHash String    @map("PasswordHash") @db.VarChar(255)
  fullName     String?   @map("FullName") @db.VarChar(150)
  role         String    @map("Role") @db.VarChar(30)
  companyId    Int?      @map("CompanyId")
  isActive     Boolean   @default(true) @map("IsActive")
  createdAt    DateTime  @default(now()) @map("CreatedAt")
  lastLoginAt  DateTime? @map("LastLoginAt")
  permissions  String?   @map("Permissions")
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_User_Company")

  @@map("User")
}

model WorkOrder {
  id                   Int                   @id(map: "PK__WorkOrde__3214EC07B767C033") @default(autoincrement()) @map("Id")
  orderNumber          Int                   @map("OrderNumber")
  CompanyId            Int                   @default(1) @map("CompanyId")
  customerName         String?               @map("CustomerName") @db.VarChar(150)
  phone                String?               @map("Phone") @db.VarChar(50)
  email                String?               @map("Email") @db.VarChar(150)
  address              String?               @map("Address") @db.VarChar(250)
  brand                String?               @map("Brand") @db.VarChar(80)
  model                String?               @map("Model") @db.VarChar(80)
  vehicleYear          Int?                  @map("VehicleYear")
  color                String?               @map("Color") @db.VarChar(50)
  plate                String?               @map("Plate") @db.VarChar(30)
  mileage              String?               @map("Mileage") @db.VarChar(50)
  mileageUnit          String?               @map("MileageUnit") @db.VarChar(5)
  engine               String?               @map("Engine") @db.VarChar(50)
  status               String                @default("RECEIVED") @map("Status") @db.VarChar(50)
  notes                String?               @map("Notes") 
  createdAt            DateTime?             @default(now()) @map("CreatedAt")
  updatedAt            DateTime?             @map("UpdatedAt")
  quotationId          Int?                  @map("QuotationId")
  Vin                  String?               @db.VarChar(30)
  NationalId           String?               @db.VarChar(30)
  PromisedDate         DateTime?             @db.Date
  ReceivedAt           DateTime?
  DeliveredAt          DateTime?
  ProgressPercent      Decimal               @default(0) @db.Decimal(5, 2)
  inventoryMovements   InventoryMovement[]
  invoices             Invoice[]
  laborOrders               LaborOrder[]
  EmployeePaymentWorkLine   EmployeePaymentWorkLine[]
  materialRequisitions      MaterialRequisition[]
  convertedFrom        Quotation[]           @relation("QuotationConvertedWorkOrder")
  quotation            Quotation?            @relation("WorkOrderFromQuotation", fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_WorkOrder_Quotation")
  damages              WorkOrderDamage[]
  photos               WorkOrderPhoto[]
  receptions           WorkOrderReception[]
  company              Company               @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_WorkOrder_Company")

  @@unique([CompanyId, orderNumber], map: "UQ_WorkOrder_Company_OrderNumber")
  @@index([CompanyId], map: "IX_WorkOrder_CompanyId")
  @@map("WorkOrder")
}

model InventoryPart {
  id                      Int                       @id(map: "PK_InventoryPart") @default(autoincrement()) @map("Id")
  CompanyId               Int                       @default(1) @map("CompanyId")
  sku                     String                    @map("Sku") @db.VarChar(50)
  name                    String                    @map("Name") @db.VarChar(150)
  description             String?                   @map("Description") @db.VarChar(250)
  category                String?                   @map("Category") @db.VarChar(80)
  PartType                String                    @default("MATERIAL") @db.VarChar(20)
  unit                    String                    @default("PZ") @map("Unit") @db.VarChar(20)
  quantityOnHand          Decimal                   @default(0) @map("QuantityOnHand") @db.Decimal(18, 2)
  reservedQuantity        Decimal                   @default(0) @map("ReservedQuantity") @db.Decimal(18, 2)
  minQuantity             Decimal?                  @map("MinQuantity") @db.Decimal(18, 2)
  unitCost                Decimal?                  @map("UnitCost") @db.Decimal(18, 2)
  location                String?                   @map("Location") @db.VarChar(80)
  isActive                Boolean                   @default(true) @map("IsActive")
  createdAt               DateTime                  @default(now()) @map("CreatedAt")
  createdBy               String?                   @map("CreatedBy") @db.VarChar(150)
  updatedAt               DateTime?                 @map("UpdatedAt")
  updatedBy               String?                   @map("UpdatedBy") @db.VarChar(150)
  movements               InventoryMovement[]
  MaterialRequisitionItem MaterialRequisitionItem[]
  quotationMaterialLines  QuotationMaterialLine[]
  company                 Company                   @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_InventoryPart_Company")

  @@unique([CompanyId, sku], map: "UQ_InventoryPart_Company_Sku")
  @@index([CompanyId, isActive], map: "IX_InventoryPart_CompanyId")
  @@index([name], map: "IX_InventoryPart_Name")
  @@index([PartType, isActive], map: "IX_InventoryPart_PartType")
  @@map("InventoryPart")
}

model InventoryMovement {
  id                    Int                  @id(map: "PK_InventoryMovement") @default(autoincrement()) @map("Id")
  inventoryPartId       Int                  @map("InventoryPartId")
  movementType          String               @map("MovementType") @db.VarChar(20)
  quantity              Decimal              @map("Quantity") @db.Decimal(18, 2)
  quantityBefore        Decimal?             @map("QuantityBefore") @db.Decimal(18, 2)
  quantityAfter         Decimal?             @map("QuantityAfter") @db.Decimal(18, 2)
  unitCostAtMovement    Decimal?             @map("UnitCostAtMovement") @db.Decimal(18, 2)
  reason                String?              @map("Reason") @db.VarChar(50)
  workOrderId           Int?                 @map("WorkOrderId")
  notes                 String?              @map("Notes") @db.VarChar(250)
  createdBy             String?              @map("CreatedBy") @db.VarChar(150)
  createdAt             DateTime             @default(now()) @map("CreatedAt")
  MaterialRequisitionId Int?
  part                  InventoryPart        @relation(fields: [inventoryPartId], references: [id], onUpdate: NoAction, map: "FK_InventoryMovement_Part")
  MaterialRequisition   MaterialRequisition? @relation(fields: [MaterialRequisitionId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_InventoryMovement_Requisition")
  workOrder             WorkOrder?           @relation(fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_InventoryMovement_WorkOrder")

  @@index([inventoryPartId, createdAt(sort: Desc)], map: "IX_InventoryMovement_PartId")
  @@index([workOrderId], map: "IX_InventoryMovement_WorkOrderId")
  @@map("InventoryMovement")
}

model WorkOrderReception {
  id                        Int                           @id(map: "PK__WorkOrde__3214EC0705CE3673") @default(autoincrement()) @map("Id")
  workOrderId               Int                           @map("WorkOrderId")
  deliveryDate              DateTime?                     @map("DeliveryDate") @db.Date
  deliveryTime              DateTime?                     @map("DeliveryTime") @db.Time
  exitDate                  DateTime?                     @map("ExitDate") @db.Date
  exitTime                  DateTime?                     @map("ExitTime") @db.Time
  fuelLevel                 Int?                          @default(50) @map("FuelLevel")
  observations              String?                       @map("Observations") 
  requestedDamages          String?                       @map("RequestedDamages") 
  customerDeliverySignature String?                       @map("CustomerDeliverySignature") @db.VarChar(500)
  customerReceivedSignature String?                       @map("CustomerReceivedSignature") @db.VarChar(500)
  receivedBy                String?                       @map("ReceivedBy") @db.VarChar(150)
  deliveredBy               String?                       @map("DeliveredBy") @db.VarChar(150)
  createdAt                 DateTime?                     @default(now()) @map("CreatedAt")
  workOrder                 WorkOrder                     @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_WorkOrderReception_WorkOrder")
  checklist                 WorkOrderReceptionChecklist[]

  @@map("WorkOrderReception")
}

model WorkOrderReceptionChecklist {
  id                   Int                @id(map: "PK__WorkOrde__3214EC07A4BFEC1A") @default(autoincrement()) @map("Id")
  workOrderReceptionId Int                @map("WorkOrderReceptionId")
  itemName             String             @map("ItemName") @db.VarChar(100)
  isChecked            Boolean            @default(false) @map("IsChecked")
  yesValue             Boolean?           @map("YesValue")
  noValue              Boolean?           @map("NoValue")
  comments             String?            @map("Comments") 
  hasComment           Boolean            @default(false) @map("HasComment")
  reception            WorkOrderReception @relation(fields: [workOrderReceptionId], references: [id], onUpdate: NoAction, map: "FK_Checklist_Reception")

  @@map("WorkOrderReceptionChecklist")
}

model WorkOrderPhoto {
  id          Int       @id(map: "PK__WorkOrde__3214EC0782CDD5C9") @default(autoincrement()) @map("Id")
  workOrderId Int       @map("WorkOrderId")
  photoUrl    String    @map("PhotoUrl") @db.VarChar(500)
  photoType   String?   @map("PhotoType") @db.VarChar(50)
  description String?   @map("Description") @db.VarChar(250)
  createdAt   DateTime? @default(now()) @map("CreatedAt")
  Category    String?   @db.VarChar(50)
  CreatedBy   String?   @db.VarChar(150)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_WorkOrderPhoto_WorkOrder")

  @@map("WorkOrderPhoto")
}

model WorkOrderDamage {
  id          Int       @id(map: "PK__WorkOrde__3214EC0797756682") @default(autoincrement()) @map("Id")
  workOrderId Int       @map("WorkOrderId")
  vehicleSide String?   @map("VehicleSide") @db.VarChar(30)
  damageType  String?   @map("DamageType") @db.VarChar(50)
  positionX   Decimal?  @map("PositionX") @db.Decimal(10, 4)
  positionY   Decimal?  @map("PositionY") @db.Decimal(10, 4)
  zoneNumber  Int?      @map("ZoneNumber")
  description String?   @map("Description") @db.VarChar(250)
  PartName    String?   @db.VarChar(150)
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_WorkOrderDamage_WorkOrder")

  @@map("WorkOrderDamage")
}

model MaterialRequisition {
  id                Int                       @id(map: "PK__Material__3214EC076872FBDF") @default(autoincrement()) @map("Id")
  workOrderId       Int                       @map("WorkOrderId")
  disassembler      String?                   @map("Disassembler") @db.VarChar(150)
  desab             String?                   @map("Desab") @db.VarChar(150)
  prep              String?                   @map("Prep") @db.VarChar(150)
  painter           String?                   @map("Painter") @db.VarChar(150)
  polisher          String?                   @map("Polisher") @db.VarChar(150)
  total             Decimal?                  @map("Total") @db.Decimal(18, 2)
  createdAt         DateTime?                 @default(now()) @map("CreatedAt")
  RequisitionNumber Int?
  Status            String                    @default("PENDING") @db.VarChar(30)
  RequestedBy       String?                   @db.VarChar(150)
  ApprovedBy        String?                   @db.VarChar(150)
  ApprovedAt        DateTime?
  DeliveredAt       DateTime?
  InventoryMovement InventoryMovement[]
  workOrder         WorkOrder                 @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_MaterialRequisition_WorkOrder")
  items             MaterialRequisitionItem[]

  @@map("MaterialRequisition")
}

model MaterialRequisitionItem {
  id                    Int                 @id(map: "PK__Material__3214EC07554D5DF4") @default(autoincrement()) @map("Id")
  materialRequisitionId Int                 @map("MaterialRequisitionId")
  productName           String              @map("ProductName") @db.VarChar(150)
  quantity              Decimal?            @map("Quantity") @db.Decimal(18, 2)
  unitPrice             Decimal?            @map("UnitPrice") @db.Decimal(18, 2)
  total                 Decimal?            @map("Total") @db.Decimal(18, 2)
  assignedEmployee      String?             @map("AssignedEmployee") @db.VarChar(150)
  InventoryPartId       Int?
  LineType              String              @default("MATERIAL") @db.VarChar(20)
  Unit                  String?             @db.VarChar(20)
  requisition           MaterialRequisition @relation(fields: [materialRequisitionId], references: [id], onUpdate: NoAction, map: "FK_MaterialItem_Requisition")
  InventoryPart         InventoryPart?      @relation(fields: [InventoryPartId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_MaterialRequisitionItem_InventoryPart")

  @@map("MaterialRequisitionItem")
}

model LaborOrder {
  id             Int              @id(map: "PK__LaborOrd__3214EC07E1DA3F99") @default(autoincrement()) @map("Id")
  workOrderId    Int              @map("WorkOrderId")
  disassembler   String?          @map("Disassembler") @db.VarChar(150)
  desab          String?          @map("Desab") @db.VarChar(150)
  prep           String?          @map("Prep") @db.VarChar(150)
  painter        String?          @map("Painter") @db.VarChar(150)
  polisher       String?          @map("Polisher") @db.VarChar(150)
  total          Decimal?         @map("Total") @db.Decimal(18, 2)
  createdAt      DateTime?        @default(now()) @map("CreatedAt")
  OrderNumber    Int?
  Status         String           @default("PENDING") @db.VarChar(30)
  technician     String?          @map("Technician") @db.VarChar(150)
  Area           String?          @db.VarChar(50)
  StartedAt      DateTime?
  FinishedAt     DateTime?
  EstimatedHours Decimal?         @db.Decimal(8, 2)
  ActualHours    Decimal?         @db.Decimal(8, 2)
  EmployeeId     Int?
  Employee                 Employee?                 @relation(fields: [EmployeeId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_LaborOrder_Employee")
  workOrder                WorkOrder                 @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_LaborOrder_WorkOrder")
  items                    LaborOrderItem[]
  EmployeePaymentWorkLine  EmployeePaymentWorkLine[]

  @@map("LaborOrder")
}

model LaborOrderItem {
  id               Int        @id(map: "PK__LaborOrd__3214EC07B9FF4953") @default(autoincrement()) @map("Id")
  laborOrderId     Int        @map("LaborOrderId")
  partName         String     @map("PartName") @db.VarChar(150)
  disassemblerCost Decimal?   @map("DisassemblerCost") @db.Decimal(18, 2)
  desabCost        Decimal?   @map("DesabCost") @db.Decimal(18, 2)
  prepCost         Decimal?   @map("PrepCost") @db.Decimal(18, 2)
  painterCost      Decimal?   @map("PainterCost") @db.Decimal(18, 2)
  polisherCost     Decimal?   @map("PolisherCost") @db.Decimal(18, 2)
  total            Decimal?   @map("Total") @db.Decimal(18, 2)
  quantity         Decimal?   @map("Quantity") @db.Decimal(18, 2)
  unitPrice        Decimal?   @map("UnitPrice") @db.Decimal(18, 2)
  laborOrder              LaborOrder                @relation(fields: [laborOrderId], references: [id], onUpdate: NoAction, map: "FK_LaborItem_LaborOrder")
  EmployeePaymentWorkLine EmployeePaymentWorkLine[]

  @@map("LaborOrderItem")
}

model Quotation {
  id               Int                     @id(map: "PK_Quotation") @default(autoincrement()) @map("Id")
  CompanyId        Int                     @default(1) @map("CompanyId")
  quotationNumber  Int                     @map("QuotationNumber")
  quotationDate    DateTime                @default(dbgenerated("CURRENT_DATE")) @map("QuotationDate") @db.Date
  validUntil       DateTime?               @map("ValidUntil") @db.Date
  quotationType    String                  @default("PRIVATE") @map("QuotationType") @db.VarChar(20)
  status           String                  @default("DRAFT") @map("Status") @db.VarChar(30)
  customerName     String                  @map("CustomerName") @db.VarChar(150)
  phone            String?                 @map("Phone") @db.VarChar(50)
  email            String?                 @map("Email") @db.VarChar(150)
  nationalId       String?                 @map("NationalId") @db.VarChar(30)
  address          String?                 @map("Address") @db.VarChar(250)
  brand            String?                 @map("Brand") @db.VarChar(80)
  model            String?                 @map("Model") @db.VarChar(80)
  vehicleYear      Int?                    @map("VehicleYear")
  color            String?                 @map("Color") @db.VarChar(50)
  plate            String?                 @map("Plate") @db.VarChar(30)
  vin              String?                 @map("Vin") @db.VarChar(30)
  mileage          String?                 @map("Mileage") @db.VarChar(50)
  insuranceCompany String?                 @map("InsuranceCompany") @db.VarChar(150)
  insurerRnc       String?                 @map("InsurerRnc") @db.VarChar(30)
  claimNumber      String?                 @map("ClaimNumber") @db.VarChar(80)
  adjusterName     String?                 @map("AdjusterName") @db.VarChar(150)
  adjusterPhone    String?                 @map("AdjusterPhone") @db.VarChar(50)
  laborSubtotal    Decimal                 @default(0) @map("LaborSubtotal") @db.Decimal(18, 2)
  materialSubtotal Decimal                 @default(0) @map("MaterialSubtotal") @db.Decimal(18, 2)
  partsSubtotal    Decimal                 @default(0) @map("PartsSubtotal") @db.Decimal(18, 2)
  taxRate          Decimal                 @default(0.18) @map("TaxRate") @db.Decimal(5, 4)
  taxAmount        Decimal                 @default(0) @map("TaxAmount") @db.Decimal(18, 2)
  discountAmount   Decimal                 @default(0) @map("DiscountAmount") @db.Decimal(18, 2)
  grandTotal       Decimal                 @default(0) @map("GrandTotal") @db.Decimal(18, 2)
  estimatedDays    Int?                    @map("EstimatedDays")
  warrantyNotes    String?                 @map("WarrantyNotes") @db.VarChar(500)
  termsNotes       String?                 @map("TermsNotes") 
  internalNotes    String?                 @map("InternalNotes") 
  workOrderId      Int?                    @map("WorkOrderId")
  approvedAt       DateTime?               @map("ApprovedAt")
  approvedBy       String?                 @map("ApprovedBy") @db.VarChar(150)
  rejectedAt       DateTime?               @map("RejectedAt")
  rejectedBy       String?                 @map("RejectedBy") @db.VarChar(150)
  rejectionReason  String?                 @map("RejectionReason") @db.VarChar(500)
  convertedAt      DateTime?               @map("ConvertedAt")
  convertedBy      String?                 @map("ConvertedBy") @db.VarChar(150)
  createdAt        DateTime                @default(now()) @map("CreatedAt")
  createdBy        String?                 @map("CreatedBy") @db.VarChar(150)
  updatedAt        DateTime?               @map("UpdatedAt")
  updatedBy        String?                 @map("UpdatedBy") @db.VarChar(150)
  deductibleAmount Decimal?                @map("DeductibleAmount") @db.Decimal(18, 2)
  policyNumber     String?                 @map("PolicyNumber") @db.VarChar(80)
  invoices         Invoice[]
  workOrder        WorkOrder?              @relation("QuotationConvertedWorkOrder", fields: [workOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Quotation_WorkOrder")
  damages          QuotationDamage[]
  laborLines       QuotationLaborLine[]
  materialLines    QuotationMaterialLine[]
  partLines        QuotationPartLine[]
  photos           QuotationPhoto[]
  sourceOrders     WorkOrder[]             @relation("WorkOrderFromQuotation")
  company          Company                 @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_Quotation_Company")

  @@unique([CompanyId, quotationNumber], map: "UQ_Quotation_Company_Number")
  @@index([customerName], map: "IX_Quotation_Customer")
  @@index([plate], map: "IX_Quotation_Plate")
  @@index([status, quotationDate(sort: Desc)], map: "IX_Quotation_Status")
  @@map("Quotation")
}

model QuotationLaborLine {
  id             Int       @id(map: "PK_QuotationLaborLine") @default(autoincrement()) @map("Id")
  quotationId    Int       @map("QuotationId")
  area           String    @map("Area") @db.VarChar(50)
  description    String?   @map("Description") @db.VarChar(250)
  estimatedHours Decimal?  @map("EstimatedHours") @db.Decimal(8, 2)
  hourlyRate     Decimal?  @map("HourlyRate") @db.Decimal(18, 2)
  lineTotal      Decimal   @default(0) @map("LineTotal") @db.Decimal(18, 2)
  sortOrder      Int       @default(0) @map("SortOrder")
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_QuotationLaborLine_Quotation")

  @@map("QuotationLaborLine")
}

model QuotationMaterialLine {
  id              Int            @id(map: "PK_QuotationMaterialLine") @default(autoincrement()) @map("Id")
  quotationId     Int            @map("QuotationId")
  inventoryPartId Int?           @map("InventoryPartId")
  productName     String         @map("ProductName") @db.VarChar(150)
  quantity        Decimal        @default(1) @map("Quantity") @db.Decimal(18, 2)
  unit            String?        @map("Unit") @db.VarChar(20)
  unitPrice       Decimal        @default(0) @map("UnitPrice") @db.Decimal(18, 2)
  lineTotal       Decimal        @default(0) @map("LineTotal") @db.Decimal(18, 2)
  sortOrder       Int            @default(0) @map("SortOrder")
  inventoryPart   InventoryPart? @relation(fields: [inventoryPartId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_QuotationMaterialLine_Part")
  quotation       Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_QuotationMaterialLine_Quotation")

  @@map("QuotationMaterialLine")
}

model QuotationPartLine {
  id          Int       @id(map: "PK_QuotationPartLine") @default(autoincrement()) @map("Id")
  quotationId Int       @map("QuotationId")
  partName    String    @map("PartName") @db.VarChar(150)
  description String?   @map("Description") @db.VarChar(250)
  quantity    Decimal   @default(1) @map("Quantity") @db.Decimal(18, 2)
  unitPrice   Decimal   @default(0) @map("UnitPrice") @db.Decimal(18, 2)
  lineTotal   Decimal   @default(0) @map("LineTotal") @db.Decimal(18, 2)
  sortOrder   Int       @default(0) @map("SortOrder")
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_QuotationPartLine_Quotation")

  @@map("QuotationPartLine")
}

model QuotationDamage {
  id          Int       @id(map: "PK_QuotationDamage") @default(autoincrement()) @map("Id")
  quotationId Int       @map("QuotationId")
  partName    String?   @map("PartName") @db.VarChar(150)
  vehicleSide String?   @map("VehicleSide") @db.VarChar(30)
  damageType  String?   @map("DamageType") @db.VarChar(50)
  description String?   @map("Description") @db.VarChar(500)
  positionX   Decimal?  @map("PositionX") @db.Decimal(10, 4)
  positionY   Decimal?  @map("PositionY") @db.Decimal(10, 4)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_QuotationDamage_Quotation")

  @@map("QuotationDamage")
}

model QuotationPhoto {
  id          Int       @id(map: "PK_QuotationPhoto") @default(autoincrement()) @map("Id")
  quotationId Int       @map("QuotationId")
  photoUrl    String    @map("PhotoUrl") @db.VarChar(500)
  category    String?   @map("Category") @db.VarChar(50)
  description String?   @map("Description") @db.VarChar(250)
  createdAt   DateTime  @default(now()) @map("CreatedAt")
  createdBy   String?   @map("CreatedBy") @db.VarChar(150)
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_QuotationPhoto_Quotation")

  @@map("QuotationPhoto")
}

model Invoice {
  id               Int           @id(map: "PK_Invoice") @default(autoincrement()) @map("Id")
  CompanyId        Int           @default(1) @map("CompanyId")
  invoiceNumber    Int           @map("InvoiceNumber")
  invoiceDate      DateTime      @default(dbgenerated("CURRENT_DATE")) @map("InvoiceDate") @db.Date
  workOrderId      Int           @map("WorkOrderId")
  quotationId      Int?          @map("QuotationId")
  customerName     String        @map("CustomerName") @db.VarChar(150)
  nationalId       String?       @map("NationalId") @db.VarChar(30)
  phone            String?       @map("Phone") @db.VarChar(50)
  email            String?       @map("Email") @db.VarChar(150)
  address          String?       @map("Address") @db.VarChar(250)
  brand            String?       @map("Brand") @db.VarChar(80)
  model            String?       @map("Model") @db.VarChar(80)
  vehicleYear      Int?          @map("VehicleYear")
  plate            String?       @map("Plate") @db.VarChar(30)
  vin              String?       @map("Vin") @db.VarChar(30)
  billingType      String        @default("PRIVATE") @map("BillingType") @db.VarChar(20)
  status           String        @default("PENDING") @map("Status") @db.VarChar(30)
  laborSubtotal    Decimal       @default(0) @map("LaborSubtotal") @db.Decimal(18, 2)
  materialSubtotal Decimal       @default(0) @map("MaterialSubtotal") @db.Decimal(18, 2)
  partsSubtotal    Decimal       @default(0) @map("PartsSubtotal") @db.Decimal(18, 2)
  subtotal         Decimal       @default(0) @map("Subtotal") @db.Decimal(18, 2)
  discountAmount   Decimal       @default(0) @map("DiscountAmount") @db.Decimal(18, 2)
  taxRate          Decimal       @default(0.18) @map("TaxRate") @db.Decimal(5, 4)
  taxAmount        Decimal       @default(0) @map("TaxAmount") @db.Decimal(18, 2)
  grandTotal       Decimal       @default(0) @map("GrandTotal") @db.Decimal(18, 2)
  paidAt           DateTime?     @map("PaidAt")
  paidBy           String?       @map("PaidBy") @db.VarChar(150)
  paymentReference String?       @map("PaymentReference") @db.VarChar(100)
  voidedAt         DateTime?     @map("VoidedAt")
  voidedBy         String?       @map("VoidedBy") @db.VarChar(150)
  voidReason       String?       @map("VoidReason") @db.VarChar(500)
  notes            String?       @map("Notes") 
  createdAt        DateTime      @default(now()) @map("CreatedAt")
  createdBy        String?       @map("CreatedBy") @db.VarChar(150)
  updatedAt        DateTime?     @map("UpdatedAt")
  updatedBy        String?       @map("UpdatedBy") @db.VarChar(150)
  quotation        Quotation?    @relation(fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Invoice_Quotation")
  workOrder        WorkOrder     @relation(fields: [workOrderId], references: [id], onUpdate: NoAction, map: "FK_Invoice_WorkOrder")
  company          Company       @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_Invoice_Company")
  lines            InvoiceLine[]

  @@unique([CompanyId, invoiceNumber], map: "UQ_Invoice_Company_Number")
  @@index([status, invoiceDate(sort: Desc)], map: "IX_Invoice_Status")
  @@map("Invoice")
}

model InvoiceLine {
  id          Int     @id(map: "PK_InvoiceLine") @default(autoincrement()) @map("Id")
  invoiceId   Int     @map("InvoiceId")
  lineType    String  @map("LineType") @db.VarChar(20)
  sourceType  String? @map("SourceType") @db.VarChar(30)
  sourceId    Int?    @map("SourceId")
  description String  @map("Description") @db.VarChar(250)
  quantity    Decimal @default(1) @map("Quantity") @db.Decimal(18, 2)
  unitPrice   Decimal @default(0) @map("UnitPrice") @db.Decimal(18, 2)
  lineTotal   Decimal @default(0) @map("LineTotal") @db.Decimal(18, 2)
  sortOrder   Int     @default(0) @map("SortOrder")
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_InvoiceLine_Invoice")

  @@map("InvoiceLine")
}

model WorkshopSettings {
  id              Int       @id(map: "PK_WorkshopSettings") @map("Id")
  CompanyId       Int?      @unique(map: "UQ_WorkshopSettings_CompanyId") @map("CompanyId")
  businessName    String    @map("BusinessName") @db.VarChar(150)
  legalName       String?   @map("LegalName") @db.VarChar(200)
  rnc             String?   @map("Rnc") @db.VarChar(30)
  phone           String?   @map("Phone") @db.VarChar(50)
  email           String?   @map("Email") @db.VarChar(150)
  address         String?   @map("Address") @db.VarChar(250)
  logoUrl         String?   @map("LogoUrl") @db.VarChar(500)
  defaultTaxRate  Decimal   @default(0.18) @map("DefaultTaxRate") @db.Decimal(5, 4)
  quotationFooter String?   @map("QuotationFooter") 
  quotationWarrantyNotes String? @map("QuotationWarrantyNotes") 
  quotationPaymentNotes String? @map("QuotationPaymentNotes") 
  invoiceFooter   String?   @map("InvoiceFooter") 
  updatedAt       DateTime? @map("UpdatedAt")
  updatedBy       String?   @map("UpdatedBy") @db.VarChar(150)
  stampUrl        String?   @map("StampUrl") @db.VarChar(500)
  company         Company?  @relation(fields: [CompanyId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_WorkshopSettings_Company")

  @@map("WorkshopSettings")
}

model AuditLog {
  Id          BigInt   @id(map: "PK_AuditLog") @default(autoincrement())
  OccurredAt  DateTime @default(now())
  UserName    String?  @db.VarChar(150)
  Action      String   @db.VarChar(50)
  EntityType  String   @db.VarChar(50)
  EntityId    Int?
  EntityLabel String?  @db.VarChar(200)
  WorkOrderId Int?
  QuotationId Int?
  Details     String?  
  IpAddress   String?  @db.VarChar(45)

  @@index([EntityType, EntityId, OccurredAt(sort: Desc)], map: "IX_AuditLog_Entity")
  @@index([OccurredAt(sort: Desc)], map: "IX_AuditLog_Occurred")
  @@index([WorkOrderId, OccurredAt(sort: Desc)], map: "IX_AuditLog_WorkOrder")
}

// ─── Módulo de Gastos ───────────────────────────────────────────────────────

model ExpenseCategory {
  Id        Int       @id(map: "PK_ExpenseCategory") @default(autoincrement())
  CompanyId Int       @default(1) @map("CompanyId")
  Name      String    @db.VarChar(100)
  Color     String?   @db.VarChar(7)
  IsActive  Boolean   @default(true)
  CreatedAt DateTime  @default(now())
  expenses  Expense[]
  company   Company   @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_ExpenseCategory_Company")

  @@unique([CompanyId, Name], map: "UQ_ExpenseCategory_Company_Name")
  @@index([CompanyId, IsActive], map: "IX_ExpenseCategory_Company")
}

model Expense {
  Id                    Int                    @id(map: "PK_Expense") @default(autoincrement())
  CompanyId             Int                    @default(1) @map("CompanyId")
  ExpenseNumber         Int
  CategoryId            Int
  Description           String                 @db.VarChar(250)
  Amount                Decimal                @db.Decimal(18, 2)
  ExpenseDate           DateTime               @db.Date
  Supplier              String?                @db.VarChar(150)
  Reference             String?                @db.VarChar(100)
  Notes                 String?                @db.VarChar(500)
  PaymentMethod         String?                @db.VarChar(30)
  ReceiptUrl            String?                @db.VarChar(500)
  BankAccountId         Int?
  PettyCashTransactionId Int?
  Status                String                 @default("REGISTERED") @db.VarChar(20)
  CreatedBy             String?                @db.VarChar(150)
  CreatedAt             DateTime               @default(now())
  UpdatedAt             DateTime?
  category              ExpenseCategory        @relation(fields: [CategoryId], references: [Id], onUpdate: NoAction, map: "FK_Expense_Category")
  company               Company                @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_Expense_Company")
  bankAccount           BankAccount?           @relation(fields: [BankAccountId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Expense_BankAccount")
  pettyCashTransaction  PettyCashTransaction?  @relation(fields: [PettyCashTransactionId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Expense_PettyCash")

  @@unique([CompanyId, ExpenseNumber], map: "UQ_Expense_Company_Number")
  @@index([CompanyId, ExpenseDate(sort: Desc)], map: "IX_Expense_Company_Date")
  @@index([CategoryId], map: "IX_Expense_Category")
  @@index([BankAccountId], map: "IX_Expense_BankAccount")
}

// ─── Módulo de Bancos ───────────────────────────────────────────────────────

model BankAccount {
  Id              Int               @id(map: "PK_BankAccount") @default(autoincrement())
  CompanyId       Int               @default(1) @map("CompanyId")
  AccountName     String            @db.VarChar(150)
  BankName        String            @db.VarChar(100)
  AccountNumber   String?           @db.VarChar(50)
  AccountType     String            @default("CHECKING") @db.VarChar(20)
  Currency        String            @default("DOP") @db.VarChar(3)
  CurrentBalance  Decimal           @default(0) @db.Decimal(18, 2)
  IsActive        Boolean           @default(true)
  Notes           String?           @db.VarChar(250)
  CreatedAt       DateTime          @default(now())
  UpdatedAt       DateTime?
  transactions    BankTransaction[]
  expenses        Expense[]
  company         Company           @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_BankAccount_Company")

  @@index([CompanyId, IsActive], map: "IX_BankAccount_Company")
}

model BankTransaction {
  Id              Int         @id(map: "PK_BankTransaction") @default(autoincrement())
  BankAccountId   Int
  TransactionType String     @db.VarChar(20)
  Amount          Decimal    @db.Decimal(18, 2)
  BalanceAfter    Decimal    @db.Decimal(18, 2)
  Description     String     @db.VarChar(250)
  Reference       String?    @db.VarChar(100)
  TransactionDate DateTime   @db.Date
  Category        String?    @db.VarChar(50)
  Notes           String?    @db.VarChar(250)
  CreatedBy       String?    @db.VarChar(150)
  CreatedAt       DateTime   @default(now())
  bankAccount     BankAccount @relation(fields: [BankAccountId], references: [Id], onUpdate: NoAction, map: "FK_BankTransaction_Account")

  @@index([BankAccountId, TransactionDate(sort: Desc)], map: "IX_BankTransaction_Account_Date")
}

// ─── Módulo de Caja Chica ───────────────────────────────────────────────────

model PettyCashFund {
  Id             Int                    @id(map: "PK_PettyCashFund") @default(autoincrement())
  CompanyId      Int                    @default(1) @map("CompanyId")
  Name           String                 @db.VarChar(100)
  FundLimit      Decimal                @db.Decimal(18, 2)
  CurrentBalance Decimal                @default(0) @db.Decimal(18, 2)
  Custodian      String?                @db.VarChar(150)
  IsActive       Boolean                @default(true)
  CreatedAt      DateTime               @default(now())
  UpdatedAt      DateTime?
  transactions   PettyCashTransaction[]
  company        Company                @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_PettyCashFund_Company")

  @@index([CompanyId, IsActive], map: "IX_PettyCashFund_Company")
}

model PettyCashTransaction {
  Id                Int           @id(map: "PK_PettyCashTransaction") @default(autoincrement())
  PettyCashFundId   Int
  TransactionType   String        @db.VarChar(20)
  Amount            Decimal       @db.Decimal(18, 2)
  BalanceAfter      Decimal       @db.Decimal(18, 2)
  Description       String        @db.VarChar(250)
  TransactionDate   DateTime      @db.Date
  ReceiptUrl        String?       @db.VarChar(500)
  Notes             String?       @db.VarChar(250)
  CreatedBy         String?       @db.VarChar(150)
  CreatedAt         DateTime      @default(now())
  fund              PettyCashFund @relation(fields: [PettyCashFundId], references: [Id], onUpdate: NoAction, map: "FK_PettyCashTransaction_Fund")
  expenses          Expense[]

  @@index([PettyCashFundId, TransactionDate(sort: Desc)], map: "IX_PettyCashTransaction_Fund_Date")
}

model Employee {
  Id                Int                 @id(map: "PK_Employee") @default(autoincrement())
  CompanyId         Int                 @default(1) @map("CompanyId")
  Name              String              @db.VarChar(150)
  Role              String              @db.VarChar(80)
  Phone             String?             @db.VarChar(50)
  NationalId        String?             @db.VarChar(30)
  DefaultUnitPrice  Decimal?            @db.Decimal(18, 2)
  IsExternal        Boolean             @default(false)
  IsActive          Boolean             @default(true)
  HiredAt           DateTime?           @db.Date
  Notes             String?             @db.VarChar(500)
  CreatedAt         DateTime            @default(now())
  EmployeePayment   EmployeePayment[]
  LaborOrder        LaborOrder[]
  PayrollSettlement PayrollSettlement[]
  company           Company             @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_Employee_Company")
}

model EmployeePayment {
  Id                                                                          Int                @id(map: "PK_EmployeePayment") @default(autoincrement())
  PaymentNumber                                                               Int                @unique(map: "UQ_EmployeePayment_Number")
  EmployeeId                                                                  Int
  Type                                                                        String             @db.VarChar(20)
  Amount                                                                      Decimal            @db.Decimal(18, 2)
  PaymentDate                                                                 DateTime           @db.Date
  PaymentMethod                                                               String?            @db.VarChar(30)
  Reference                                                                   String?            @db.VarChar(100)
  Notes                                                                       String?            @db.VarChar(500)
  PayrollPeriodId                                                             Int?
  PayrollSettlementId                                                         Int?
  DeductedInSettlementId                                                      Int?
  Status                                                                      String             @default("PAID") @db.VarChar(20)
  PaidBy                                                                      String?            @db.VarChar(150)
  CreatedAt                                                                   DateTime           @default(now())
  PayrollSettlement_EmployeePayment_DeductedInSettlementIdToPayrollSettlement PayrollSettlement? @relation("EmployeePayment_DeductedInSettlementIdToPayrollSettlement", fields: [DeductedInSettlementId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_EmployeePayment_Deducted")
  Employee                                                                    Employee           @relation(fields: [EmployeeId], references: [Id], onUpdate: NoAction, map: "FK_EmployeePayment_Employee")
  PayrollPeriod                                                               PayrollPeriod?     @relation(fields: [PayrollPeriodId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_EmployeePayment_Period")
  PayrollSettlement_EmployeePayment_PayrollSettlementIdToPayrollSettlement    PayrollSettlement? @relation("EmployeePayment_PayrollSettlementIdToPayrollSettlement", fields: [PayrollSettlementId], references: [Id], onDelete: NoAction, onUpdate: NoAction, map: "FK_EmployeePayment_Settlement")
  EmployeePaymentWorkLine                                                     EmployeePaymentWorkLine[]
}

model EmployeePaymentWorkLine {
  Id                Int             @id(map: "PK_EmployeePaymentWorkLine") @default(autoincrement())
  EmployeePaymentId Int
  LaborOrderId      Int
  LaborOrderItemId  Int
  WorkOrderId       Int
  WorkOrderNumber   Int
  Plate             String?         @db.VarChar(30)
  Description       String          @db.VarChar(250)
  Quantity          Decimal         @db.Decimal(18, 2)
  UnitPrice         Decimal         @db.Decimal(18, 2)
  Amount            Decimal         @db.Decimal(18, 2)
  EmployeePayment   EmployeePayment @relation(fields: [EmployeePaymentId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_EmployeePaymentWorkLine_Payment")
  LaborOrder        LaborOrder      @relation(fields: [LaborOrderId], references: [id], onUpdate: NoAction, map: "FK_EmployeePaymentWorkLine_LaborOrder")
  LaborOrderItem    LaborOrderItem  @relation(fields: [LaborOrderItemId], references: [id], onUpdate: NoAction, map: "FK_EmployeePaymentWorkLine_LaborItem")
  WorkOrder         WorkOrder       @relation(fields: [WorkOrderId], references: [id], onUpdate: NoAction, map: "FK_EmployeePaymentWorkLine_WorkOrder")

  @@index([EmployeePaymentId], map: "IX_EmployeePaymentWorkLine_Payment")
  @@index([LaborOrderItemId], map: "IX_EmployeePaymentWorkLine_LaborItem")
}

model PayrollLine {
  Id                  Int               @id(map: "PK_PayrollLine") @default(autoincrement())
  PayrollSettlementId Int
  SourceType          String            @db.VarChar(20)
  LaborOrderId        Int?
  LaborOrderItemId    Int?
  WorkOrderId         Int?
  Description         String            @db.VarChar(250)
  Quantity            Decimal           @db.Decimal(18, 2)
  UnitPrice           Decimal           @db.Decimal(18, 2)
  Amount              Decimal           @db.Decimal(18, 2)
  PayrollSettlement   PayrollSettlement @relation(fields: [PayrollSettlementId], references: [Id], onDelete: Cascade, onUpdate: NoAction, map: "FK_PayrollLine_Settlement")
}

model PayrollPeriod {
  Id                Int                 @id(map: "PK_PayrollPeriod") @default(autoincrement())
  CompanyId         Int                 @default(1) @map("CompanyId")
  PeriodStart       DateTime            @db.Date
  PeriodEnd         DateTime            @db.Date
  Status            String              @default("OPEN") @db.VarChar(20)
  ClosedAt          DateTime?
  PaidAt            DateTime?
  Notes             String?             @db.VarChar(500)
  CreatedAt         DateTime            @default(now())
  EmployeePayment   EmployeePayment[]
  PayrollSettlement PayrollSettlement[]
  company           Company             @relation(fields: [CompanyId], references: [id], onUpdate: NoAction, map: "FK_PayrollPeriod_Company")
}

model PayrollSettlement {
  Id                                                                        Int               @id(map: "PK_PayrollSettlement") @default(autoincrement())
  PayrollPeriodId                                                           Int
  EmployeeId                                                                Int
  GrossAmount                                                               Decimal           @default(0) @db.Decimal(18, 2)
  AdvancesAmount                                                            Decimal           @default(0) @db.Decimal(18, 2)
  AdjustmentsAmount                                                         Decimal           @default(0) @db.Decimal(18, 2)
  NetAmount                                                                 Decimal           @default(0) @db.Decimal(18, 2)
  Status                                                                    String            @default("PENDING") @db.VarChar(20)
  CreatedAt                                                                 DateTime          @default(now())
  EmployeePayment_EmployeePayment_DeductedInSettlementIdToPayrollSettlement EmployeePayment[] @relation("EmployeePayment_DeductedInSettlementIdToPayrollSettlement")
  EmployeePayment_EmployeePayment_PayrollSettlementIdToPayrollSettlement    EmployeePayment[] @relation("EmployeePayment_PayrollSettlementIdToPayrollSettlement")
  PayrollLine                                                               PayrollLine[]
  Employee                                                                  Employee          @relation(fields: [EmployeeId], references: [Id], onUpdate: NoAction, map: "FK_PayrollSettlement_Employee")
  PayrollPeriod                                                             PayrollPeriod     @relation(fields: [PayrollPeriodId], references: [Id], onUpdate: NoAction, map: "FK_PayrollSettlement_Period")

  @@unique([PayrollPeriodId, EmployeeId], map: "UQ_PayrollSettlement_PeriodEmployee")
}
